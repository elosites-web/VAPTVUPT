# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE FORMS - TRABALHE CONOSCO
# Cole a URL do Google Forms criado para recrutamento (ex: https://docs.google.com/forms/d/e/.../viewform)
VITE_GOOGLE_FORMS_CAREERS_URL="TODO-CONFIGURAR-GOOGLE-FORMS"

# GOOGLE ANALYTICS 4 (Opcional)
# ID de métrica do GA4 no formato G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=""

# GOOGLE SEARCH CONSOLE (Opcional)
# Código da meta tag de verificação do Google Search Console
VITE_GSC_VERIFICATION_CODE=""
